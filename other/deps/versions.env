# Pinned sources for other/build_deps.sh.
#
# The dependencies (FFmpeg, libplacebo, libass, ...) are built with IINA's
# official build scripts. This file pins those scripts and overrides the
# versions that must change so that libmpv supports the gpu-next renderer.

# IINA's official dependency build scripts.
DEPS_BUILDSCRIPTS_REPO="https://github.com/iina/deps-buildscripts.git"
# ee35579 (2026-10-08): FFmpeg 9.0.2, OpenSSL TLS backend, libaribcaption.
DEPS_BUILDSCRIPTS_COMMIT="ee35579ded3ea95d839d85c2686d96dc505ee344"

# mpv has no release with a gpu-next render API for libmpv yet (the newest
# release is v0.41.0). So build mpv master at a fixed commit, and apply the
# patches in patches/mpv/:
#   * 18607: the gpu-next render API from mpv pull request #18607.
#   * 18357: a build fix for macOS without Vulkan (mpv issue #18357). mpv
#     master fails to compile video/out/mac/view.swift when -Dvulkan=disabled.
MPV_REPO="https://github.com/mpv-player/mpv.git"
# a687796 (2026-11-02): mpv master.
MPV_COMMIT="a687796d9d0efded1787d497167facd462b8f2ee"

# mpv master requires libplacebo >= 7.387.0. The build scripts pin 7.360.1.
LIBPLACEBO_VERSION="7.387.0"

# Vulkan renderer: libplacebo and mpv are built with Vulkan, so that IINA can
# render with gpu-next on Vulkan (MPV_RENDER_API_TYPE_VULKAN) and run compute
# shaders. These are installed by the extra build scripts in other/deps/.
#
# MoltenVK translates Vulkan to Metal. The official release is a universal
# dylib (arm64 and x86_64) for macOS 12.0 and later, with Vulkan headers 1.4.357.
# mpv links to it directly, without the Vulkan loader.
MOLTENVK_VERSION="1.4.2"
MOLTENVK_SHA256="f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e"
MOLTENVK_URL="https://github.com/KhronosGroup/MoltenVK/releases/download/v${MOLTENVK_VERSION}/MoltenVK-macos.tar"
# glslang compiles mpv's GLSL shaders to SPIR-V, the shader format of Vulkan.
# It is built as static libraries and linked into libplacebo.
GLSLANG_VERSION="16.6.0"
GLSLANG_SHA256="9c09b901149c729df745057dafa815278aaa101b84d2b6e14f16a42de52f97f2"
GLSLANG_URL="https://github.com/KhronosGroup/glslang/archive/refs/tags/${GLSLANG_VERSION}.tar.gz"
