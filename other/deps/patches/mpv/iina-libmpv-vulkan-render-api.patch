index 83d9290..b408691 100644
--- a/video/out/gpu_next/libmpv_gpu_next.c
+++ b/video/out/gpu_next/libmpv_gpu_next.c
@@ -25,20 +25,72 @@
 #endif
 #endif
 
+#if HAVE_VULKAN
+#include "mpv/render_vk.h"
+#include "video/out/placebo/ra_pl.h"
+#endif
+
 struct priv {
     struct libmpv_gpu_context *context;
     struct pl_video *renderer;
     pl_log pllog;
+    pl_gpu gpu;
+    bool vulkan; // MPV_RENDER_API_TYPE_VULKAN, otherwise OpenGL
 #if HAVE_GL && defined(PL_HAVE_OPENGL)
     pl_opengl opengl;
 #endif
 };
 
+#if HAVE_VULKAN
+// MPV_RENDER_API_TYPE_VULKAN: the host owns the Vulkan device, and
+// libmpv_gpu_context_vk imports it into libplacebo. The renderer is the same
+// gpu-next renderer as for OpenGL, but compute shaders are available.
+static int init_vulkan(struct render_backend *ctx, mpv_render_param *params)
+{
+    struct priv *p = ctx->priv = talloc_zero(NULL, struct priv);
+    p->vulkan = true;
+    p->context = talloc_zero(p, struct libmpv_gpu_context);
+    *p->context = (struct libmpv_gpu_context) {
+        .global = ctx->global,
+        .log = ctx->log,
+        .fns = &libmpv_gpu_context_vk,
+    };
+    int err = libmpv_gpu_context_init(p->context, params);
+    if (err < 0)
+        return err;
+
+    struct ra_ctx *ra_ctx = p->context->ra_ctx;
+    ra_ctx->opts.want_alpha = pl_video_wants_alpha(ctx->global);
+    p->pllog = mppl_log_create(p, ctx->log);
+    p->gpu = ra_pl_get(ra_ctx->ra);
+    if (!p->pllog || !p->gpu)
+        return MPV_ERROR_UNSUPPORTED;
+
+    p->renderer = pl_video_init(ra_ctx, p->pllog, p->gpu, ctx->global, ctx->log);
+    if (!p->renderer)
+        return MPV_ERROR_UNSUPPORTED;
+
+    // Same as for OpenGL: load the interops now. On macOS this includes
+    // hwdec_vt_pl, which maps VideoToolbox frames through VK_EXT_metal_objects.
+    pl_video_load_hwdec_api(p->renderer, &(struct hwdec_imgfmt_request) {
+        .imgfmt = IMGFMT_NONE,
+        .probing = true,
+    });
+    ctx->hwdec_devs = pl_video_get_hwdec_devices(p->renderer);
+    ctx->driver_caps = VO_CAP_ROTATE90 | VO_CAP_FILM_GRAIN | VO_CAP_VFLIP;
+    return 0;
+}
+#endif
+
 static int init(struct render_backend *ctx, mpv_render_param *params)
 {
     const char *api = get_mpv_render_param(params, MPV_RENDER_PARAM_API_TYPE, NULL);
     if (!api)
         return MPV_ERROR_INVALID_PARAMETER;
+#if HAVE_VULKAN
+    if (strcmp(api, MPV_RENDER_API_TYPE_VULKAN) == 0)
+        return init_vulkan(ctx, params);
+#endif
     if (strcmp(api, MPV_RENDER_API_TYPE_OPENGL_NEXT))
         return MPV_ERROR_NOT_IMPLEMENTED;
 
@@ -78,6 +130,7 @@ static int init(struct render_backend *ctx, mpv_render_param *params)
     p->opengl = pl_opengl_create(p->pllog, &gl_params);
     if (!p->opengl)
         return MPV_ERROR_UNSUPPORTED;
+    p->gpu = p->opengl->gpu;
 
     p->renderer = pl_video_init(ra_ctx, p->pllog, p->opengl->gpu,
                                 ctx->global, ctx->log);
@@ -153,6 +206,21 @@ static void resize(struct render_backend *ctx, struct mp_rect *src,
 static int get_target_size(struct render_backend *ctx, mpv_render_param *params,
                            int *out_w, int *out_h)
 {
+#if HAVE_VULKAN
+    struct priv *vp = ctx->priv;
+    if (vp->vulkan) {
+        mpv_vulkan_image *img =
+            get_mpv_render_param(params, MPV_RENDER_PARAM_VULKAN_IMAGE, NULL);
+        if (!img || img->width <= 0 || img->height <= 0)
+            return MPV_ERROR_INVALID_PARAMETER;
+        int max_size = vp->gpu->limits.max_tex_2d_dim;
+        if (img->width > max_size || img->height > max_size)
+            return MPV_ERROR_INVALID_PARAMETER;
+        *out_w = img->width;
+        *out_h = img->height;
+        return 0;
+    }
+#endif
     mpv_opengl_fbo *fbo =
         get_mpv_render_param(params, MPV_RENDER_PARAM_OPENGL_FBO, NULL);
     if (!fbo || fbo->w <= 0 || fbo->h <= 0)
@@ -168,9 +236,59 @@ static int get_target_size(struct render_backend *ctx, mpv_render_param *params,
     return 0;
 }
 
+#if HAVE_VULKAN
+static int render_vulkan(struct render_backend *ctx, mpv_render_param *params,
+                         struct vo_frame *frame)
+{
+    struct priv *p = ctx->priv;
+    struct ra_tex *ra_target;
+    int err = p->context->fns->wrap_fbo(p->context, params, &ra_target);
+    if (err < 0)
+        return err;
+    // mppl_wrap_tex() stores the wrapped pl_tex in priv. The context owns it
+    // until done_frame().
+    pl_tex target = ra_target->priv;
+
+    // The host's image is an RGB surface like an SDR swapchain image. The
+    // target-trc, target-prim and target-peak options override this, for
+    // example for HDR10 output into a 10-bit image.
+    struct pl_swapchain_frame swframe = {
+        .fbo = target,
+        .color_repr = pl_color_repr_rgb,
+        .color_space = pl_color_space_srgb,
+    };
+    swframe.color_repr.alpha = pl_video_wants_alpha(ctx->global)
+                               ? PL_ALPHA_INDEPENDENT : PL_ALPHA_NONE;
+    // Dither to the bit depth of the image format, unless the host says
+    // otherwise.
+    int depth = GET_MPV_RENDER_PARAM(params, MPV_RENDER_PARAM_DEPTH, int, 0);
+    if (depth <= 0)
+        depth = target->params.format->component_depth[0];
+    if (depth > 0) {
+        swframe.color_repr.bits.sample_depth = depth;
+        swframe.color_repr.bits.color_depth = depth;
+    }
+    struct pl_video_target display = {
+        .color = swframe.color_space,
+        .depth = depth > 0 ? depth : 8,
+        .color_known = true,
+    };
+    bool flip = GET_MPV_RENDER_PARAM(params, MPV_RENDER_PARAM_FLIP_Y, int, 0);
+    bool ok = pl_video_render_frame(p->renderer, frame, &swframe, flip, &display);
+    // Submits the work, moves the image to final_layout and signals the
+    // host's semaphore.
+    p->context->fns->done_frame(p->context, frame->display_synced);
+    return ok ? 0 : MPV_ERROR_GENERIC;
+}
+#endif
+
 static int render(struct render_backend *ctx, mpv_render_param *params,
                   struct vo_frame *frame)
 {
+#if HAVE_VULKAN
+    if (((struct priv *)ctx->priv)->vulkan)
+        return render_vulkan(ctx, params, frame);
+#endif
 #if HAVE_GL && defined(PL_HAVE_OPENGL)
     struct priv *p = ctx->priv;
     struct ra_tex *ra_target;
